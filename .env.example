# Folder outside the repository for fetched documents, parsed pages and run outputs.
TSTT_DATA_DIR=

# Meta Model API (https://dev.meta.ai). Never commit a real key.
MODEL_API_KEY=
MODEL_API_BASE=https://api.meta.ai/v1
HOSTED_MODEL=muse-spark-1.3
# Hosted requests stop once the recorded spend reaches this many US dollars (the billing
# page only sends a notification). Leave empty for no limit.
MODEL_SPEND_LIMIT_USD=50

# Local chat completions server running Muse Glimmer (LM Studio or llama.cpp).
LOCAL_API_BASE=http://127.0.0.1:1234/v1
LOCAL_MODEL=muse-glimmer-30b
LOCAL_API_KEY=

# SEC EDGAR asks every client to identify itself with a contact address.
SEC_USER_AGENT=
